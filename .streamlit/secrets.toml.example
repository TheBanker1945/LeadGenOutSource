# Streamlit Secrets Configuration
# Copy this file to secrets.toml and fill in your values
# DO NOT commit secrets.toml to git (it's already in .gitignore)

# Client Authentication
# Generate password hash: https://docs.streamlit.io/library/api-reference/utilities/st.experimental_user
[credentials]
usernames = { client1 = { name = "Client Name", password = "$2b$12$your_hashed_password_here" } }

[cookie]
name = "lead_gen_auth"
key = "random_signature_key_12345"  # Change this to a random string
expiry_days = 30

# API Keys (if you're managing them)
[api_keys]
GOOGLE_MAPS_API_KEY = "your_google_maps_api_key_here"
GOOGLE_GEMINI_API_KEY = "your_gemini_api_key_here"
